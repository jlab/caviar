env {
    PATH = "/vol/jlab/tlin/software/cli_links:/vol/jlab/tlin/software/ass_links:$PATH"
}

// vol/software/bin was thrown out

params {
    sample_dir = "/vol/jlab/tlin/marbel_benchmarking_integration/benchmarking_sets/merged_microbiomes"
    pattern = "*_R{1,2}.fastq.gz"
    result_dir = "/vol/jlab/tlin/all_project/nf_results/assembler_benchmark_pipeline/marbel_benchmarking_sets"
//    sample_dir = "/vol/jlab/tlin/all_project/nf_results/mt_preprocess/RNA_241107/merged"
//    pattern = "*_R{1,2}.fastq.gz"
//    result_dir = "/vol/jlab/tlin/all_project/nf_results/assembler_benchmark_pipeline/RNA_merged_241107"
//    sample_dir = "/vol/jlab/tlin/all_project/nf_results/RNAnf_sixteenspreprocess/241107_VH01369_31_AACKFKJHV/merged"
//    pattern = '*_R{1,2}.fastq.gz'
//    result_dir = "/vol/jlab/tlin/all_project/nf_results/assembler_benchmark_pipeline/RNA_merged_241107"
//    sample_dir = '/vol/jlab/tlin/marbel_benchmarking_integration/dataset1/merged'
//    pattern = '*_R{1,2}.fastq.gz'
//    result_dir = "/vol/jlab/tlin/all_project/nf_results/assembler_benchmark_pipeline/dataset_test"
//    sample_dir = '/vol/jlab/evolp_share/fastq_merged/'
//    pattern = '*.R{1,2}.fastq.gz'
//    result_dir = "/vol/jlab/tlin/all_project/nf_results/assembler_benchmark_pipeline/combined" 
//    sample_dir = '/vol/jlab/tlin/all_project/nf_results/mt_preprocess/readrepair'
//    pattern = '*_T1_R{1,2}.id_changed.fastq.gz'
}



process {
    executor = 'slurm'
    queueSize = 600
    cpus = 64
    memory = '1950G'
    //errorStrategy = 'finish'
    errorStrategy = { task.attempt <= 5 ? 'retry' : 'finish' }
    maxRetries = 5

    beforeScript = """
        var=/var/scratch/\$USER/process_tmp_\$(date +%s%N)\$RANDOM
        echo $USER >> log.txt
        echo \$var > podman_dir.txt
        mkdir -p \$var/podman
        export XDG_RUNTIME_DIR=\$var/podman
        export TMPDIR=\$var
        export http_proxy=http://192.168.10.1:3128
        export https_proxy=http://192.168.10.1:3128
        export ftp_proxy=http://192.168.10.1:3128
    """

    withName: TransLiG {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'

    }

    withName: ingapCdg {
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: IDBA_MT {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: IDBA_TRAN {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: rnabloom {
        memory = '480G'
        queue = 'idle'
        time = '120h'
        cpus = 120
    }

    withName: Oases {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Velvetg {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Velveth {
        cpus = 4
        memory = '1950G'
        queue = 'idle'
        time = '150h'
    }

    withName: DBG {
        cpus = 64
        memory = '480G'
    }

    withName: SOAPdenovoTrans {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: TransABySS {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Trinity {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

}

podman {
    enabled = true
    runOptions = '--group-add keep-groups --userns=keep-id'
}

singularity {
    enabled = false
    runOptions = '--bind /etc:/etc'
}

conda {
    enabled = false
}
