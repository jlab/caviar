env {
    PATH = "/vol/jlab/tlin/software/cli_links:/vol/jlab/tlin/software/ass_links:$PATH"
}

// vol/software/bin was thrown out

params {
    read_length = 126
    insert_size = 350
}

process {
    executor = 'slurm'
    queueSize = 600
    cpus = 64
    memory = '1950G'
    //errorStrategy = 'finish'
    errorStrategy = { task.attempt <= 5 ? 'retry' : 'finish' }
    maxRetries = 5
    clusterOptions = '--exclude=rs620-bcf-1-4.intra,rs620-bcf-1-6.intra,rs500-bcf-02.intra'

    beforeScript = """
        var=/var/scratch/\$USER/process_tmp_\$(date +%s%N)\$RANDOM
        echo $USER >> log.txt
        echo \$var > podman_dir.txt
        mkdir -p \$var/podman
        export XDG_RUNTIME_DIR=\$var/podman
        export TMPDIR=\$var
        export http_proxy=http://192.168.10.1:3128
        export https_proxy=http://192.168.10.1:3128
        export ftp_proxy=http://192.168.10.1:3128
    """

    withName: TransLiG {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: ingapCdg {
        memory = '1950G'
        queue = 'idle'
        time = '120h'
    }

    withName: IDBA_MT {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: IDBA_TRAN {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: rnabloom {
        memory = '1950G'
        queue = 'idle'
        time = '140h'
        cpus = 200
    }

    withName: Oases {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Velvetg {
        cpus = 4
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Velveth {
        cpus = 4
        memory = '480G'
        time = '23h'
    }

    withName: DBG {
        cpus = 64
        memory = '480G'
        queue = 'idle'
        time = '96h'
    }

    withName: SOAPdenovoTrans {
        cpus = 120
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: TransABySS {
        cpus = 128
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

    withName: Trinity {
        cpus = 128
        memory = '480G'
        queue = 'idle'
        time = '150h'
    }

}

podman {
    enabled = true
    runOptions = '--group-add keep-groups --userns=keep-id'
}

singularity {
    enabled = false
    runOptions = '--bind /etc:/etc'
}

conda {
    enabled = false
}
